# Copy to .env.local (never commit it) and fill in. The same names go into Vercel env vars.

# Resend: API key with sending + receiving access
RESEND_API_KEY=
# Signing secret of the Resend `email.received` webhook (add after the first deploy; see README)
RESEND_WEBHOOK_SECRET=

# Supabase Postgres, pooled (transaction mode, port 6543) connection string
DATABASE_URL=
# Optional: connections per server instance (default 5)
# DATABASE_POOL_MAX=5
# Supabase project URL and service-role key (server-side Storage access only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# External address that receives login codes (must NOT be an address on tanakadev.digital)
OWNER_EMAIL=
# Sender for normal mail and for login codes
MAIL_FROM="Name <me@tanakadev.digital>"
AUTH_FROM="Login <login@tanakadev.digital>"

# Public origin of the app (used for Origin checks), e.g. https://mail.tanakadev.digital
APP_URL=http://localhost:3000

# Web Push (optional). Generate a pair with `npm run vapid`, set both, redeploy. Leave empty to keep notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
