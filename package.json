    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "svix": "^2.9.0",
    "tsx": "^4.23.15",
